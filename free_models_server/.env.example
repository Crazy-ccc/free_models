DATABASE_URL=sqlite://free_models.db?mode=rwc
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DB_MAX_CONNECTIONS=100
RUST_LOG=info

# 缓存 TTL（秒）
SCHEDULER_CACHE_TTL_SEC=30

